{
  "name": "@ariontalk/widget",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/ariontalk.js",
  "module": "./dist/ariontalk.js",
  "description": "Drop-in voice AI widget for any website — powered by Gemini Live with interactive highlights",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luixaviles/ariontalk.git",
    "directory": "packages/widget"
  },
  "homepage": "https://ariontalk.com",
  "keywords": ["voice", "ai", "widget", "web-component", "gemini", "highlights", "lit"],
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/ariontalk.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist tsconfig.tsbuildinfo && vite build && tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {
    "@ariontalk/core": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@ariontalk/engine-gemini": "workspace:*",
    "lit": "^3.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.x"
  }
}
