{
  "name": "@ariontalk/widget",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/ariontalk.esm.js",
  "module": "./dist/ariontalk.esm.js",
  "jsdelivr": "./dist/ariontalk.js",
  "unpkg": "./dist/ariontalk.js",
  "description": "Drop-in voice AI widget for any website — powered by Gemini Live with interactive highlights",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luixaviles/ariontalk.git",
    "directory": "packages/widget"
  },
  "homepage": "https://ariontalk.com",
  "keywords": [
    "voice",
    "ai",
    "widget",
    "web-component",
    "gemini",
    "highlights",
    "lit"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ariontalk.esm.js",
      "default": "./dist/ariontalk.esm.js"
    },
    "./cdn": {
      "types": "./dist/index.d.ts",
      "default": "./dist/ariontalk.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist tsconfig.tsbuildinfo && BUILD_TARGET=cdn vite build && vite build && tsc --emitDeclarationOnly",
    "postbuild": "node scripts/verify-build.js && publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ariontalk/core": "workspace:*",
    "@ariontalk/engine-local": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.2.0",
    "@ariontalk/engine-gemini": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.x",
    "@ariontalk/engine-gemini": "workspace:*",
    "jsdom": "^25.0.1",
    "lit": "^3.2.0",
    "publint": "^0.3.x",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.x"
  },
  "peerDependenciesMeta": {
    "@ariontalk/engine-gemini": {
      "optional": true
    }
  }
}
