<section class="landing-section">
  <div class="landing-container">
    <p class="section-label">The Problem</p>
    <h2 class="section-title">Users Don't Read — They Scan</h2>
    <p class="section-subtitle">Traditional chatbots add another text box to an already text-heavy page. The result? More reading, not less.</p>

    <div class="problem-solution-grid">
      <div class="problem-card">
        <div class="ps-card-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <line x1="7" y1="8" x2="17" y2="8"/>
            <line x1="7" y1="12" x2="17" y2="12"/>
            <line x1="7" y1="16" x2="13" y2="16"/>
            <rect x="12" y="14" width="9" height="9" rx="2" fill="var(--landing-surface)" stroke="currentColor"/>
            <line x1="15" y1="17" x2="19" y2="17"/>
            <line x1="15" y1="19" x2="18" y2="19"/>
            <line x1="15" y1="21" x2="19" y2="21"/>
          </svg>
        </div>
        <h3 class="ps-card-title">Text In, Text Out</h3>
        <p class="ps-card-desc">Chat widgets force users to type questions and read answers. It's another wall of text on top of your existing content.</p>
      </div>

      <div class="ps-arrow" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--landing-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </div>

      <div class="solution-card">
        <div class="ps-card-icon ps-card-icon--accent">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a3 3 0 0 0-3 3v4a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
            <path d="M19 10v1a7 7 0 0 1-14 0v-1"/>
            <rect x="2" y="16" width="20" height="6" rx="2" stroke="currentColor" opacity="0.5"/>
            <rect x="4" y="18" width="6" height="2" rx="1" fill="var(--landing-accent)" opacity="0.4"/>
            <line x1="12" y1="14" x2="12" y2="16" stroke="currentColor" stroke-dasharray="2 2"/>
          </svg>
        </div>
        <h3 class="ps-card-title">Voice In, Highlights Out</h3>
        <p class="ps-card-desc">ArionTalk lets users speak naturally. The AI responds with voice while scrolling to and highlighting the exact content being discussed.</p>
      </div>
    </div>
  </div>
</section>
