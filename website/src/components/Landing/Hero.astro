<section class="hero">
  <div class="landing-container">
    <div class="hero-badge">
      <span class="hero-badge-dot"></span>
      Open Source Voice AI
    </div>
    <h1 class="hero-title">Talk to <span class="gradient-text">Any Website</span></h1>
    <p class="hero-tagline">A lightweight voice assistant that reads your content, sees your images, and highlights what it's talking about — powered by Gemini.</p>

    <div class="hero-pills">
      <span class="hero-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        Real-time Voice
      </span>
      <span class="hero-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Page Understanding
      </span>
      <span class="hero-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        Interactive Highlights
      </span>
    </div>

    <div class="hero-actions">
      <a href="#live-demo" class="btn btn-primary">Try the Live Demo</a>
      <a href="https://github.com/luixaviles/ariontalk" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">View Source</a>
    </div>

    <div class="hero-illustration">
      <svg viewBox="0 0 800 320" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="ArionTalk voice AI flow: a microphone sends audio waves to the ArionTalk engine, which connects to webpage content blocks and highlights relevant sections in real time">
        <!-- Microphone -->
        <g transform="translate(100, 80)">
          <rect x="22" y="0" width="16" height="40" rx="8" stroke="var(--landing-accent)" stroke-width="2.5" fill="none"/>
          <path d="M10 30v4a20 20 0 0 0 40 0v-4" stroke="var(--landing-accent)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <line x1="30" y1="54" x2="30" y2="66" stroke="var(--landing-accent)" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="20" y1="66" x2="40" y2="66" stroke="var(--landing-accent)" stroke-width="2.5" stroke-linecap="round"/>
        </g>

        <!-- Waveform lines from mic to center — smooth flowing curves -->
        <g stroke="var(--landing-accent)" stroke-width="1.5" stroke-linecap="round" fill="none">
          <path d="M170 118 Q230 104 290 118 Q330 128 350 120" opacity="0.25" class="hero-wave hero-wave-1"/>
          <path d="M170 132 Q240 114 310 132 Q340 144 352 134" opacity="0.35" class="hero-wave hero-wave-2"/>
          <path d="M170 148 Q240 166 310 148 Q340 136 352 146" opacity="0.35" class="hero-wave hero-wave-3"/>
          <path d="M170 162 Q230 176 290 162 Q330 152 350 160" opacity="0.25" class="hero-wave hero-wave-4"/>
        </g>

        <!-- Central node — ArionTalk logo (larger) -->
        <g transform="translate(350, 90)">
          <circle cx="50" cy="50" r="50" stroke="var(--landing-accent)" stroke-width="2" fill="none" opacity="0.25"/>
          <!-- Shield + wave bars (scaled up to fill r=50 circle) -->
          <g transform="translate(16, 14) scale(0.53)">
            <path d="M64 6L12 28v36c0 28 22 48 52 58c30-10 52-30 52-58V28z" fill="var(--landing-accent)" opacity="0.85"/>
            <rect x="34" y="47" width="8" height="22" rx="4" fill="white" class="hero-bar hero-bar-1"/>
            <rect x="47" y="39" width="8" height="38" rx="4" fill="white" class="hero-bar hero-bar-2"/>
            <rect x="60" y="47" width="8" height="22" rx="4" fill="white" class="hero-bar hero-bar-3"/>
            <rect x="73" y="39" width="8" height="38" rx="4" fill="white" class="hero-bar hero-bar-4"/>
            <rect x="86" y="47" width="8" height="22" rx="4" fill="white" class="hero-bar hero-bar-5"/>
          </g>
        </g>

        <!-- Connection lines to page elements -->
        <g stroke="var(--landing-accent)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.4">
          <path d="M452 115 Q495 85 530 70"/>
          <path d="M452 140 Q505 140 540 140"/>
          <path d="M452 165 Q495 195 530 210"/>
        </g>

        <!-- Page element: text block with highlight -->
        <g transform="translate(530, 40)">
          <rect x="0" y="0" width="180" height="65" rx="8" stroke="var(--landing-border)" stroke-width="1.5" fill="var(--landing-surface)" opacity="0.8"/>
          <rect x="12" y="12" width="120" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
          <rect x="12" y="24" width="150" height="6" rx="3" fill="var(--landing-accent)" opacity="0.5"/>
          <rect x="12" y="24" width="150" height="6" rx="3" stroke="var(--landing-accent)" stroke-width="1" fill="none" opacity="0.8" class="hero-highlight"/>
          <rect x="12" y="36" width="100" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
          <rect x="12" y="48" width="130" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
        </g>

        <!-- Page element: image block -->
        <g transform="translate(540, 115)">
          <rect x="0" y="0" width="70" height="55" rx="6" stroke="var(--landing-border)" stroke-width="1.5" fill="var(--landing-surface)" opacity="0.8"/>
          <circle cx="22" cy="20" r="8" fill="var(--landing-text-muted)" opacity="0.3"/>
          <path d="M5 40 L20 28 L35 38 L50 25 L65 35 L65 49 Q65 55 59 55 L11 55 Q5 55 5 49 Z" fill="var(--landing-text-muted)" opacity="0.2"/>
        </g>

        <!-- Page element: text block 2 with highlight glow -->
        <g transform="translate(530, 185)">
          <rect x="0" y="0" width="180" height="65" rx="8" stroke="var(--landing-border)" stroke-width="1.5" fill="var(--landing-surface)" opacity="0.8"/>
          <rect x="12" y="12" width="90" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
          <rect x="12" y="24" width="140" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
          <rect x="12" y="36" width="155" height="6" rx="3" fill="var(--landing-accent)" opacity="0.5"/>
          <rect x="12" y="36" width="155" height="6" rx="3" stroke="var(--landing-accent)" stroke-width="1" fill="none" opacity="0.8" class="hero-highlight"/>
          <rect x="12" y="48" width="110" height="6" rx="3" fill="var(--landing-text-muted)" opacity="0.4"/>
        </g>

        <!-- Highlight glow effects -->
        <circle cx="620" cy="72" r="50" fill="var(--landing-accent)" opacity="0.04" class="hero-glow"/>
        <circle cx="620" cy="218" r="50" fill="var(--landing-accent)" opacity="0.04" class="hero-glow"/>
      </svg>
    </div>
  </div>
</section>
