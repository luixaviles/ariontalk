---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props}><slot /></Default>

<!-- Force light theme regardless of system preference -->
<script is:inline>
  document.documentElement.dataset.theme = 'light';
  localStorage.setItem('starlight-theme', 'light');
</script>

<!-- Widget for docs pages: script runs after DOM is ready and appends to <body> directly -->
<script>
  import '@ariontalk/widget';

  const solsticeTokens = {
    light: {
      '--at-primary-color': '#F55036',
      '--at-primary-text': '#FFFFFF',
      '--at-text-color': '#151515',
      '--at-text-secondary': '#6B6560',
      '--at-text-muted': '#A39E98',
      '--at-bg-color': '#FFFDF5',
      '--at-surface-color': '#FAF9F4',
      '--at-surface-hover': '#F3F1EA',
      '--at-border-color': '#EAE6DE',
      '--at-font-family': "'Inter', system-ui, sans-serif",
      '--at-shadow-color': 'rgba(21, 21, 21, 0.1)',
      '--at-shadow-hover': 'rgba(21, 21, 21, 0.16)',
      '--at-focus-ring': 'rgba(245, 80, 54, 0.3)',
      '--at-success-color': '#10B981',
      '--at-error-color': '#EF4444',
      '--at-error-hover': '#DC2626',
    },
    dark: {
      '--at-primary-color': '#F55036',
      '--at-primary-text': '#FFFFFF',
      '--at-text-color': '#FAF8F2',
      '--at-text-secondary': '#A8A29E',
      '--at-text-muted': '#78716C',
      '--at-bg-color': '#0F0D0A',
      '--at-surface-color': '#1C1A16',
      '--at-surface-hover': '#292623',
      '--at-border-color': '#292623',
      '--at-font-family': "'Inter', system-ui, sans-serif",
      '--at-shadow-color': 'rgba(0, 0, 0, 0.4)',
      '--at-shadow-hover': 'rgba(0, 0, 0, 0.5)',
      '--at-focus-ring': 'rgba(245, 80, 54, 0.35)',
      '--at-success-color': '#34D399',
      '--at-error-color': '#F87171',
      '--at-error-hover': '#EF4444',
    },
  } as const;

  function applysolsticeTokens(widget: HTMLElement, theme: 'light' | 'dark') {
    const tokens = solsticeTokens[theme] ?? solsticeTokens.light;
    for (const [prop, value] of Object.entries(tokens)) {
      widget.style.setProperty(prop, value);
    }
  }

  function initWidget() {
    // Landing page already has a widget via its own layout
    if (document.querySelector('ariontalk-widget')) return;

    const widget = document.createElement('ariontalk-widget');
    widget.setAttribute('engine', 'gemini');
    widget.setAttribute('token-server', `${import.meta.env.PUBLIC_SERVER_URL}/api/token`);
    widget.setAttribute('settings', '');
    widget.setAttribute('interactive-highlights', '');
    widget.setAttribute('log-level', 'debug');

    const theme = (document.documentElement.dataset.theme || 'light') as 'light' | 'dark';
    widget.setAttribute('theme', theme);
    applysolsticeTokens(widget, theme);

    document.body.appendChild(widget);

    new MutationObserver(() => {
      const t = (document.documentElement.dataset.theme || 'light') as 'light' | 'dark';
      widget.setAttribute('theme', t);
      applysolsticeTokens(widget, t);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  // Ensure body exists before appending
  if (document.body) {
    initWidget();
  } else {
    document.addEventListener('DOMContentLoaded', initWidget);
  }
</script>
