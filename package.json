{
  "name": "ariontalk",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ariontalk/widget dev",
    "demo": "pnpm --filter @ariontalk/demo dev",
    "token-server": "pnpm --filter @ariontalk/token-server dev",
    "docs": "pnpm --filter @ariontalk/docs-site dev",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "darwin", "linux"],
      "cpu": ["current", "arm64", "x64"]
    }
  }
}
